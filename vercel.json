{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/api-server/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "artifacts/protraders-fx/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "artifacts/api-server/api/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "artifacts/api-server/api/index.ts"
    },
    {
      "src": "/oauth/(.*)",
      "dest": "artifacts/api-server/api/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/artifacts/protraders-fx/assets/$1"
    },
    {
      "src": "/(favicon\\.svg|robots\\.txt|sitemap\\.xml)",
      "dest": "/artifacts/protraders-fx/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/artifacts/protraders-fx/index.html"
    }
  ]
}