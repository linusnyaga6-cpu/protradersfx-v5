{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/api-server/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["artifacts/api-server/dist/**"]
      }
    },
    {
      "src": "artifacts/protraders-fx/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "artifacts/api-server/api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "artifacts/api-server/api/index.js"
    },
    {
      "src": "/oauth/(.*)",
      "dest": "artifacts/api-server/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}