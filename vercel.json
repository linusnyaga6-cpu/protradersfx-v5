{
  "version": 2,
  "installCommand": "corepack pnpm@10.26.1 install --frozen-lockfile",
  "builds": [
    {
      "src": "artifacts/api-server/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "artifacts/protraders-fx/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "artifacts/api-server/api/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "artifacts/api-server/api/index.ts"
    },
    {
      "src": "/oauth/(.*)",
      "dest": "artifacts/api-server/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}